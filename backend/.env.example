PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pgas_system?schema=public"
# Сгенерируйте уникальный секрет: openssl rand -base64 48
# На VPS/production обязательно свой JWT_SECRET (не оставляйте значение по умолчанию).
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
# Необязательно: если задано, имеет приоритет над датой в тексте регламента (r2)
SUBMISSION_DEADLINE_ISO=""
