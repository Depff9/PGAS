# Скопируйте в .env.production на VPS (файл не коммитится)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pgas_system
PGAS_DATA_DIR=/var/lib/pgas/postgres

PORT=4000
JWT_SECRET=change-me-use-openssl-rand-base64-48
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://demo.pgas-demo-site.online
SUBMISSION_DEADLINE_ISO=

# true только при первом развёртывании демо
PGAS_SEED_ON_START=false
